---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import ProjectModal from '../components/ProjectModal.astro';
import Skills from '../components/Skills.astro';
import Timeline from '../components/Timeline.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
---

<Layout 
  title={`${profile.name} | Portafolio de Software & Materias Universitarias`}
  description={`Portafolio de ${profile.name} (${profile.academicTitle}). Proyectos de materias universitarias (Bases de datos, Algoritmos, SO, IA) y proyectos personales.`}
>
  <Navbar />
  <main class="flex-1">
    <Hero />
    <Stats />
    <ProjectFilter />
    <Skills />
    <Timeline />
    <About />
    <Contact />
  </main>
  <Footer />
  <ProjectModal />
</Layout>
