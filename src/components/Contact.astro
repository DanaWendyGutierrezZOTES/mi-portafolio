---
import { profile } from '../data/profile';
---

<section id="contacto" class="py-16 md:py-24 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-xs font-bold text-cyan-300 shadow-sm">
        Canales de Contacto
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        ¿Tienes un Proyecto o Consulta?
      </h2>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        Estoy disponible para proyectos académicos, pasantías y colaboraciones en desarrollo de software.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Direct Contact Channels -->
      <div class="space-y-4">
        
        <a 
          href={`mailto:${profile.email}`} 
          class="p-5 rounded-3xl glass-card border border-surface-border hover:border-cyan-400/50 flex items-start gap-4 transition-all group block shadow-md"
        >
          <div class="w-11 h-11 rounded-2xl bg-cyan-500/15 text-cyan-400 flex items-center justify-center group-hover:scale-110 transition-transform shrink-0 border border-cyan-500/30">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider font-mono">Correo Electrónico</h3>
            <p class="text-sm font-semibold text-white group-hover:text-cyan-300 transition-colors mt-0.5">{profile.email}</p>
            <span class="text-xs text-cyan-400 font-bold inline-flex items-center gap-1 mt-1.5">
              Enviar correo directo &rarr;
            </span>
          </div>
        </a>

        <a 
          href={profile.linkedin} 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-5 rounded-3xl glass-card border border-surface-border hover:border-academic/50 flex items-start gap-4 transition-all group block shadow-md"
        >
          <div class="w-11 h-11 rounded-2xl bg-academic/15 text-academic-light flex items-center justify-center group-hover:scale-110 transition-transform shrink-0 border border-academic/30">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.66 1.66 0 0 0-1.66 1.66c0 .92.74 1.66 1.66 1.66a1.66 1.66 0 0 0 1.66-1.66c0-.92-.74-1.66-1.66-1.66Z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider font-mono">LinkedIn</h3>
            <p class="text-sm font-semibold text-white group-hover:text-cyan-300 transition-colors mt-0.5">Perfil de Dana Gutierrez</p>
            <span class="text-xs text-cyan-400 font-bold inline-flex items-center gap-1 mt-1.5">
              Conectar en LinkedIn &rarr;
            </span>
          </div>
        </a>

        <a 
          href={profile.github} 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-5 rounded-3xl glass-card border border-surface-border hover:border-personal/50 flex items-start gap-4 transition-all group block shadow-md"
        >
          <div class="w-11 h-11 rounded-2xl bg-personal/15 text-personal-light flex items-center justify-center group-hover:scale-110 transition-transform shrink-0 border border-personal/30">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider font-mono">GitHub</h3>
            <p class="text-sm font-semibold text-white group-hover:text-rose-300 transition-colors mt-0.5">Repositorios de Código</p>
            <span class="text-xs text-rose-400 font-bold inline-flex items-center gap-1 mt-1.5">
              Ver proyectos en GitHub &rarr;
            </span>
          </div>
        </a>

      </div>

      <!-- Quick Message Form -->
      <div class="glass-panel p-7 rounded-3xl border border-surface-border space-y-4 shadow-xl">
        <h3 class="text-base font-bold text-white">Enviar Mensaje Rápido</h3>
        
        <form action={`mailto:${profile.email}`} method="GET" class="space-y-4">
          <div>
            <label for="name" class="block text-xs font-semibold text-slate-300 mb-1.5">Nombre / Empresa</label>
            <input 
              type="text" 
              id="name" 
              name="subject"
              placeholder="Tu nombre o empresa" 
              required
              class="w-full px-4 py-2.5 text-xs sm:text-sm bg-surface border border-surface-border rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20"
            />
          </div>

          <div>
            <label for="body" class="block text-xs font-semibold text-slate-300 mb-1.5">Mensaje</label>
            <textarea 
              id="body" 
              name="body"
              rows="4" 
              placeholder="Hola Dana, revisé tus proyectos de UNIFRANZ y me gustaría conversar sobre..." 
              required
              class="w-full px-4 py-2.5 text-xs sm:text-sm bg-surface border border-surface-border rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 resize-none"
            ></textarea>
          </div>

          <button 
            type="submit"
            class="w-full py-3 px-4 rounded-xl text-xs font-bold text-slate-950 bg-gradient-to-r from-cyan-400 via-primary-300 to-rose-300 hover:from-cyan-300 hover:to-rose-200 shadow-md shadow-cyan-500/20 transition-all duration-200"
          >
            Abrir Correo para Enviar
          </button>
        </form>
      </div>

    </div>

  </div>
</section>
