---
import { profile } from '../data/profile';
---

<section id="sobre-mi" class="py-16 md:py-24 relative bg-surface/30 border-t border-surface-border/80">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Bio text -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-xs font-bold text-cyan-300 shadow-sm">
          Perfil Profesional
        </div>
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          Formación Universitaria con Visión Práctica
        </h2>
        
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          {profile.bio}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-5 rounded-2xl glass-card border border-surface-border space-y-2">
            <div class="text-xs font-bold font-mono text-cyan-400 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Enfoque Académico
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Bases sólidas en bases de datos relacionales, estructuras de datos, diseño de software y sistemas operativos en UNIFRANZ.
            </p>
          </div>

          <div class="p-5 rounded-2xl glass-card border border-surface-border space-y-2">
            <div class="text-xs font-bold font-mono text-rose-400 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              Desarrollo Autónomo
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Creación de aplicaciones web interactivas, interfaces intuitivas y soluciones para problemas reales.
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Info Card -->
      <div class="lg:col-span-5 space-y-4">
        <div class="glass-panel p-6 rounded-3xl border border-surface-border space-y-5 shadow-xl">
          <h3 class="text-base font-bold text-white border-b border-surface-border pb-3 flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Ficha del Estudiante
          </h3>

          <ul class="space-y-3.5 text-xs sm:text-sm">
            <li class="flex items-center justify-between text-slate-300">
              <span class="text-slate-400">Estudiante:</span>
              <span class="font-bold text-white">{profile.name}</span>
            </li>
            <li class="flex items-center justify-between text-slate-300">
              <span class="text-slate-400">Carrera:</span>
              <span class="font-bold text-cyan-300">{profile.academicTitle}</span>
            </li>
            <li class="flex items-center justify-between text-slate-300">
              <span class="text-slate-400">Universidad:</span>
              <span class="font-semibold text-white">UNIFRANZ</span>
            </li>
            <li class="flex items-center justify-between text-slate-300">
              <span class="text-slate-400">Semestre:</span>
              <span class="font-bold text-amber-300">{profile.currentSemester}</span>
            </li>
            <li class="flex items-center justify-between text-slate-300">
              <span class="text-slate-400">Disponibilidad:</span>
              <span class="font-bold text-emerald-400 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                Proyectos / Prácticas
              </span>
            </li>
          </ul>

          <div class="pt-2">
            <a 
              href="#contacto"
              class="w-full py-3 px-4 rounded-2xl text-xs font-bold text-center text-slate-950 bg-gradient-to-r from-cyan-400 to-primary-300 hover:from-cyan-300 hover:to-primary-200 transition-colors block shadow-md"
            >
              Contactar a Dana
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
