---
import { profile } from '../data/profile';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-surface-border bg-surface/90 py-12 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-5 text-xs text-slate-400">
    
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-cyan-400 to-rose-400 flex items-center justify-center text-slate-950 font-mono font-extrabold text-[11px] shadow-sm">
        &lt;DG/&gt;
      </div>
      <div>
        <span class="font-semibold text-slate-300">&copy; {currentYear} {profile.name}</span>
        <span class="text-slate-500"> • {profile.academicTitle} - UNIFRANZ</span>
      </div>
    </div>

    <div class="flex items-center gap-4 font-medium">
      <a href="#inicio" class="hover:text-cyan-300 transition-colors">Volver arriba &uarr;</a>
      <span class="text-slate-700">•</span>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">GitHub</a>
      <span class="text-slate-700">•</span>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">LinkedIn</a>
    </div>

  </div>
</footer>
