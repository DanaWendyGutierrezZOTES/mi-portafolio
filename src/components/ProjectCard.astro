---
import type { Project } from '../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isAcademic = project.category === 'materia';

// Convert tags to lowercase comma separated for data-filter
const tagsString = project.tags.map(t => t.toLowerCase()).join(',');
const searchKeywords = `${project.title} ${project.shortDescription} ${project.tags.join(' ')} ${project.academicMeta?.subject || ''} ${project.academicMeta?.institution || ''}`.toLowerCase();
---

<article 
  class={`project-item group relative rounded-2xl glass-card flex flex-col justify-between overflow-hidden border transition-all duration-300 ${
    isAcademic 
      ? 'border-academic/30 hover:border-cyan-400/80 hover:shadow-glow-academic' 
      : 'border-personal/30 hover:border-rose-400/80 hover:shadow-glow-personal'
  }`}
  data-category={project.category}
  data-tags={tagsString}
  data-search={searchKeywords}
  data-id={project.id}
>
  <!-- Top decorative accent line -->
  <div class={`h-1.5 w-full ${
    isAcademic 
      ? 'bg-gradient-to-r from-cyan-500 via-primary-400 to-sky-600' 
      : 'bg-gradient-to-r from-rose-500 via-pink-400 to-amber-500'
  }`}></div>

  <!-- Card Body -->
  <div class="p-6 space-y-4 flex-1">
    
    <!-- Header Metadata Bar -->
    <div class="flex items-center justify-between gap-2 text-xs">
      {isAcademic ? (
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full badge-academic font-mono font-semibold text-[11px]">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
          </svg>
          Materia: {project.academicMeta?.subject}
        </span>
      ) : (
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full badge-personal font-mono font-semibold text-[11px]">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          Proyecto Personal
        </span>
      )}

      <!-- Semester or Status badge -->
      <span class="text-[11px] font-mono text-slate-400 font-semibold">
        {isAcademic ? project.academicMeta?.semester : project.personalMeta?.status}
      </span>
    </div>

    <!-- Title & Description -->
    <div class="space-y-2">
      <h3 class="text-lg sm:text-xl font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug">
        {project.title}
      </h3>
      <p class="text-xs sm:text-sm text-slate-300/90 line-clamp-3 leading-relaxed">
        {project.shortDescription}
      </p>
    </div>

    <!-- Academic Grade or Institution Tag -->
    {isAcademic && project.academicMeta?.grade && (
      <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg bg-amber-500/10 border border-amber-500/25 text-[11px] font-bold text-amber-300">
        <span>⭐ Nota: {project.academicMeta.grade}</span>
      </div>
    )}

    <!-- Tech Stack Tags -->
    <div class="flex flex-wrap gap-1.5 pt-2">
      {project.tags.map((tag) => (
        <span class="px-2.5 py-0.5 rounded-md text-[11px] font-mono bg-surface-card border border-surface-border text-slate-300">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <!-- Card Actions Footer -->
  <div class="p-4 sm:p-5 pt-3 mt-auto border-t border-surface-border/60 bg-surface/40 flex items-center justify-between gap-2">
    <!-- View Details Modal Trigger Button -->
    <button 
      type="button"
      class="open-modal-btn text-xs font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-1.5 py-1.5 px-3 rounded-lg hover:bg-cyan-500/10 transition-colors"
      data-project-id={project.id}
    >
      <span>Ver Ficha Técnica</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <!-- External Links -->
    <div class="flex items-center gap-1.5">
      {project.githubUrl && (
        <a 
          href={project.githubUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
          title="Ver código en GitHub"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      )}

      {project.liveUrl && project.liveUrl !== '#' && (
        <a 
          href={project.liveUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-2 rounded-lg text-slate-400 hover:text-cyan-300 hover:bg-slate-800 transition-colors"
          title="Ver Demo en Vivo"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
