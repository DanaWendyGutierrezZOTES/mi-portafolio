---
import { skillCategories } from '../data/skills';
---

<section id="habilidades" class="py-16 md:py-24 relative bg-surface/40 border-t border-surface-border/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-xs font-bold text-emerald-300 shadow-sm">
        Conocimientos & Dominio
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Habilidades Técnicas y Universitarias
      </h2>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        Integración entre materias de Ciencias de la Computación en UNIFRANZ y tecnologías aplicadas al desarrollo de software.
      </p>
    </div>

    <!-- Skills Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillCategories.map((category, index) => (
        <div class="glass-card rounded-3xl p-6 border border-surface-border space-y-5 hover:border-cyan-500/40 transition-all">
          
          <!-- Category Header -->
          <div class="flex items-center gap-3.5">
            <div class={`w-11 h-11 rounded-2xl flex items-center justify-center font-bold shadow-md ${
              index === 0 ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/30' :
              index === 1 ? 'bg-rose-500/15 text-rose-300 border border-rose-500/30' :
              index === 2 ? 'bg-accent-purple/15 text-purple-300 border border-accent-purple/30' :
              index === 3 ? 'bg-sky-500/15 text-sky-300 border border-sky-500/30' :
              'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'
            }`}>
              {category.icon === 'code' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                </svg>
              )}
              {category.icon === 'layout' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
                </svg>
              )}
              {category.icon === 'server' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
                </svg>
              )}
              {category.icon === 'book-open' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              )}
              {category.icon === 'terminal' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              )}
            </div>
            <div>
              <h3 class="text-base font-bold text-white leading-tight">{category.title}</h3>
              <span class="text-xs text-slate-400 font-mono">{category.skills.length} temas clave</span>
            </div>
          </div>

          <!-- Skills list inside category -->
          <div class="space-y-2.5">
            {category.skills.map((skill) => (
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-surface/80 border border-surface-border/70 hover:border-cyan-500/40 transition-colors">
                <span class="text-xs sm:text-sm text-slate-200 font-medium flex items-center gap-2">
                  {skill.featured && (
                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                  )}
                  {skill.name}
                </span>
                <span class={`text-[11px] font-mono font-semibold px-2.5 py-0.5 rounded-md ${
                  skill.level === 'Avanzado' 
                    ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30' 
                    : skill.level === 'Intermedio' 
                    ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/30' 
                    : 'bg-slate-700/50 text-slate-300'
                }`}>
                  {skill.level}
                </span>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
